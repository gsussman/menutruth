# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for OG tags, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://www.menutruth.com

# Map Configuration (choose one)
# Mapbox: https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# Or Google Maps: https://console.cloud.google.com/
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# PostHog Analytics (optional): https://posthog.com/
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key

# Copy this file to .env.local and fill in your values
